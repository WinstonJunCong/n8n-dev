{
  "n8nVersion": "2.43.4",
  "workflowsDir": "workflows",
  "configHint": "your config node",
  "allowedHosts": [],
  "liveN8nHosts": ["n8n.your-company.example"],
  "secretRules": [
    { "id": "secret", "pattern": "(Bearer\\s+[A-Za-z0-9._-]{16,}|\\bsk-[A-Za-z0-9]{20,}|\\bxox[abp]-[A-Za-z0-9-]{10,}|\\bghp_[A-Za-z0-9]{30,})", "message": "Key or token typed into the node; move it into a credential" }
  ],
  "outsideNodeTypes": [
    "n8n-nodes-base.httpRequest", "n8n-nodes-base.postgres", "n8n-nodes-base.mySql",
    "n8n-nodes-base.slack", "n8n-nodes-base.gmail", "n8n-nodes-base.googleSheets",
    "n8n-nodes-base.airtable", "n8n-nodes-base.telegram", "n8n-nodes-base.supabase",
    "n8n-nodes-base.awsS3", "n8n-nodes-base.dataTable", "n8n-nodes-base.n8n"
  ]
}
