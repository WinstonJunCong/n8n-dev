{
  "id": "siteHealthAlert1",
  "name": "Site health alert",
  "active": false,
  "nodes": [
    {
      "id": "n1",
      "name": "Health check request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "health-check",
        "options": {}
      }
    },
    {
      "id": "n2",
      "name": "Load env_config",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [220, 0],
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "env_config"
        },
        "returnAll": true
      }
    },
    {
      "id": "n3",
      "name": "Check site status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Load env_config').first().json.STATUS_URL }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "site",
              "value": "={{ $('Health check request').first().json.body.site }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n4",
      "name": "Is site unhealthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 0],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "n5",
      "name": "Compose alert",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, -120],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "text",
              "value": "=ALERT: {{ $('Health check request').first().json.body.site }} is not healthy (status: {{ $json.status }}, {{ $json.latency_ms }} ms)",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n6",
      "name": "Send alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, -120],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Load env_config').first().json.ALERT_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}",
        "options": {}
      }
    },
    {
      "id": "n7",
      "name": "Ignore healthy site",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, 120],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a2",
              "name": "result",
              "value": "healthy",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Health check request": {
      "main": [[{ "node": "Load env_config", "type": "main", "index": 0 }]]
    },
    "Load env_config": {
      "main": [[{ "node": "Check site status", "type": "main", "index": 0 }]]
    },
    "Check site status": {
      "main": [[{ "node": "Is site unhealthy?", "type": "main", "index": 0 }]]
    },
    "Is site unhealthy?": {
      "main": [
        [{ "node": "Compose alert", "type": "main", "index": 0 }],
        [{ "node": "Ignore healthy site", "type": "main", "index": 0 }]
      ]
    },
    "Compose alert": {
      "main": [[{ "node": "Send alert", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
